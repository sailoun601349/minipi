{
  "name": "minipi",
  "version": "1.0.0",
  "private": true,
  "description": "minipi · 常驻桌面的 AI 悬浮球。选中即问、随时续聊，会话与数据全部留在本机。",
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "selftest": "node scripts/start.mjs --selftest",
    "selftest:soft": "node scripts/start.mjs --selftest --disable-gpu",
    "verify:stream": "node scripts/verify-stream.mjs",
    "verify:electron": "node scripts/check-electron.mjs",
    "verify:v04": "node scripts/verify-v04.mjs",
    "verify:scene": "node scripts/check-scene-consistency.mjs",
    "verify:sandbox": "node scripts/verify-sandbox.mjs",
    "verify:sandbox:live": "node scripts/verify-sandbox-live.mjs",
    "verify:approval": "node scripts/verify-approval.mjs",
    "verify:approval-ui": "node scripts/qa-approval-ui.mjs",
    "verify:outcome": "node scripts/verify-outcome.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:launcher": "node scripts/verify-launcher.mjs",
    "verify:launch-live": "node scripts/verify-launch-live.mjs",
    "verify:logger": "node scripts/verify-logger.mjs",
    "launch": "node scripts/launch.mjs",
    "qa:outcome-entry": "node scripts/qa-outcome-entry.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:thought": "node scripts/verify-thought-markup.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "qa:mini-continuity": "node scripts/qa-mini-continuity.mjs",
    "qa:model-panel": "node scripts/qa-model-panel.mjs",
    "verify:live": "node scripts/verify-sandbox-live.mjs",
    "postinstall": "node scripts/check-electron.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build": "node scripts/build-release.mjs",
    "build:dir": "node scripts/build-release.mjs --dir",
    "build:win": "node scripts/build-release.mjs --win",
    "build:mac": "node scripts/build-release.mjs --mac",
    "verify:packaged": "node scripts/verify-packaged.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "docx": "9.7.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "minipi"
  },
  "license": "MIT"
}
